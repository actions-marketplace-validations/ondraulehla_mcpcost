---
import Layout from '../layouts/Layout.astro';
import Pager from '../components/Pager.astro';
import { latestRun, listServers, countByStatus, tokenBand, SORTS, DEFAULT_SORT, MAX_NUMBERED_PAGE, decodeCursor, encodeCursor, ACCESS_STATUSES, SETUP_STATUSES, type SortKey } from '../lib/db';
import { bucket, label, ms, num, tokens, STATUS_LABEL } from '../lib/format';
import { GATED_STATUSES } from '../../../packages/mcpcost/src/types.ts';

const p = Astro.url.searchParams;
const q = (p.get('q') ?? '').trim().slice(0, 80);
// With no parameters at all the list opens on alive servers; ?status=all asks for every result.
const defaultView = [...p.keys()].length === 0;
const statusParam = p.get('status') ?? '';
const status = statusParam === 'all' ? '' : defaultView ? 'ok' : statusParam;
const host = p.get('host') ?? '';
const protocol = p.get('protocol') ?? '';
const transport = p.get('transport') ?? '';
// A token range: `tokens=lo-hi` in links, `tmin` and `tmax` from the form; either end may be empty.
const digits = (v: string | null) => (v ?? '').trim().replace(/[^0-9]/g, '').slice(0, 7);
const tokensParam = (() => {
  const t = p.get('tokens');
  if (t && tokenBand(t)) return t;
  const lo = digits(p.get('tmin')), hi = digits(p.get('tmax'));
  const band = tokenBand(`${lo}-${hi}`);
  if (!band) return '';
  // Ends the wrong way round are swapped; a range below the smallest number is dropped.
  return band.hi !== null && band.hi < band.lo ? `${hi}-${lo}` : `${lo}-${hi}`;
})();
const range = tokenBand(tokensParam);
const sort = (Object.keys(SORTS).includes(p.get('sort') ?? '') ? p.get('sort') : DEFAULT_SORT) as SortKey;
// Pages 1 to MAX_NUMBERED_PAGE come by number; beyond that `c` is a cursor, `d=prev` goes back, `p` is the page label.
const cursor = decodeCursor(p.get('c'));
const back = p.get('d') === 'prev';
const requestedPage = cursor ? Math.max(1, Number(p.get('p') ?? '1') || 1) : Math.min(MAX_NUMBERED_PAGE, Math.max(1, Number(p.get('page') ?? '1') || 1));

// A filtered list has no counts in the run summary; one query grouped by status gives the segment counts, the cause counts and the total.
const needsCount = Boolean(q || host || protocol || transport || tokensParam || SORTS[sort].where);
const [{ rows, hasNext, hasPrev, perPage, page, nextCursor, prevCursor }, run, counted] = await Promise.all([
  listServers({ q, status, host, protocol, transport, tokens: tokensParam, sort, page: requestedPage, cursor, back }),
  latestRun(),
  needsCount ? countByStatus({ q, host, protocol, transport, tokens: tokensParam, sort }) : Promise.resolve(null)
]);
function pageHref(n: number, c: { value: string | number | null; name: string } | null, direction?: 'prev'): string {
  const u = new URL(Astro.url);
  for (const k of ['page', 'c', 'd', 'p']) u.searchParams.delete(k);
  if (c && n > MAX_NUMBERED_PAGE) {
    u.searchParams.set('c', encodeCursor(c));
    if (direction) u.searchParams.set('d', direction);
    u.searchParams.set('p', String(n));
  } else if (n > 1) {
    u.searchParams.set('page', String(n));
  }
  return u.pathname + u.search;
}
const nextHref = hasNext ? pageHref(page + 1, nextCursor) : null;
const prevHref = hasPrev ? pageHref(page - 1, prevCursor, 'prev') : null;

/** Servers per status under the other filters: counted when a filter is on, else from the run summary with no query. */
const byStatus: Record<string, number> | null = counted ?? run?.byStatus ?? null;
const sum = (set: ReadonlySet<string>) => (byStatus ? [...set].reduce((a, s) => a + (byStatus[s] ?? 0), 0) : 0);
const allCount = byStatus ? Object.values(byStatus).reduce((a, n) => a + n, 0) : 0;
const gatedCount = sum(GATED_STATUSES);
const counts = byStatus ? { ok: byStatus.ok ?? 0, access: sum(ACCESS_STATUSES), setup: sum(SETUP_STATUSES), down: allCount - (byStatus.ok ?? 0) - gatedCount, all: allCount } : null;
type Bucket = 'ok' | 'access' | 'setup' | 'down' | 'all';
const BUCKETS: Bucket[] = ['ok', 'access', 'setup', 'down', 'all'];
const activeBucket: Bucket =
  status === 'ok' ? 'ok' : status === '' || status === 'gated' ? 'all' : status === 'access' || ACCESS_STATUSES.has(status) ? 'access' : status === 'setup' || SETUP_STATUSES.has(status) ? 'setup' : 'down';
const inBucket = (b: Bucket, k: string) => (b === 'access' ? ACCESS_STATUSES.has(k) : b === 'setup' ? SETUP_STATUSES.has(k) : b === 'down' ? k !== 'ok' && !GATED_STATUSES.has(k) : false);
/** The causes of the active bucket, with counts, zero counts left out. */
const causes: Array<{ key: string; label: string; count: number }> =
  activeBucket === 'ok' || activeBucket === 'all' || !byStatus
    ? []
    : Object.entries(STATUS_LABEL)
        .filter(([k]) => inBucket(activeBucket, k))
        .map(([k, v]) => ({ key: k, label: v, count: byStatus[k] ?? 0 }))
        .filter((c) => c.count > 0)
        .sort((a, b) => b.count - a.count);

// The total of the list: the count of its status under the other filters.
const total = counts
  ? status === ''
    ? counts.all
    : status === 'gated'
      ? gatedCount
      : status === 'ok' || status === 'access' || status === 'setup' || status === 'down'
        ? counts[status]
        : (byStatus![status] ?? 0)
  : null;
const pages = total !== null ? Math.max(1, Math.ceil(total / perPage)) : null;
const protocols = run ? Object.keys(run.protocols).filter((v) => v !== 'unknown').sort().reverse() : [];
/** The token range in words: "1 000 to 5 000 tokens", "from 20 000 tokens", "up to 1 000 tokens". */
const rangeLabel = range ? (range.hi === null ? `from ${num(range.lo)} tokens` : range.lo === 0 ? `up to ${num(range.hi)} tokens` : `${num(range.lo)} to ${num(range.hi)} tokens`) : '';
/** The hosts the host field offers: the biggest ones of the run. */
const hostOptions = (run?.topHosts ?? []).slice(0, 60).map((h) => h.host);

// The data changes once a day; three hours at the edge keeps repeat views off the database.
Astro.response.headers.set('cache-control', 'public, max-age=120, s-maxage=10800');

const filtered = Boolean(q || statusParam || host || protocol || transport || tokensParam);

/** The current URL with some parameters changed (null removes one), the page reset. A filter added to the default view keeps it on alive servers. */
function withParams(changes: Record<string, string | null>): string {
  const u = new URL(Astro.url);
  for (const k of ['page', 'c', 'd', 'p', 'tmin', 'tmax']) u.searchParams.delete(k);
  if (defaultView && !('status' in changes)) u.searchParams.set('status', 'ok');
  if (tokensParam && !('tokens' in changes)) u.searchParams.set('tokens', tokensParam);
  for (const [k, v] of Object.entries(changes)) {
    if (v === null || v === '') u.searchParams.delete(k);
    else u.searchParams.set(k, v);
  }
  // No parameters left means the default view, which is alive servers; say so in the URL only when something else is set.
  return u.pathname + u.search;
}
const bucketHref = (b: Bucket) => withParams({ status: b });

/** The filters that are on, as removable chips. The default view (alive, nothing else) shows none. */
const transportLabel: Record<string, string> = { 'streamable-http': 'streamable http', sse: 'sse', stdio: 'stdio (npm, PyPI)' };
const active: Array<{ label: string; href: string }> = [];
if (q) active.push({ label: `“${q}”`, href: withParams({ q: null }) });
if (statusParam && statusParam !== 'ok') active.push({ label: statusParam === 'all' ? 'every result' : statusParam === 'gated' ? 'needs auth or setup' : statusParam === 'access' ? 'needs auth' : statusParam === 'setup' ? 'needs setup' : statusParam === 'down' ? 'down or broken' : label(statusParam), href: withParams({ status: null }) });
if (host) active.push({ label: host, href: withParams({ host: null }) });
if (protocol) active.push({ label: `protocol ${protocol}`, href: withParams({ protocol: null }) });
if (transport) active.push({ label: transportLabel[transport] ?? transport, href: withParams({ transport: null }) });
if (tokensParam) active.push({ label: rangeLabel, href: withParams({ tokens: null }) });

/** Column headers: first click sorts the natural way (numbers high first, text A to Z), the second click flips. */
const columns: Array<{ label: string; first: SortKey; second: SortKey; num?: boolean }> = [
  { label: 'Server', first: 'name', second: 'name-desc' },
  { label: 'Result', first: 'status', second: 'status-desc' },
  { label: 'Tools', first: 'tools', second: 'tools-asc', num: true },
  { label: 'Tokens', first: 'claude', second: 'claude-asc', num: true },
  { label: 'Init', first: 'latency', second: 'latency-desc', num: true },
  { label: 'Protocol', first: 'protocol-desc', second: 'protocol' },
  { label: 'Host', first: 'host', second: 'host-desc' }
];
function sortHref(key: SortKey): string {
  const u = new URL(Astro.url);
  u.searchParams.set('sort', key);
  u.searchParams.delete('page');
  return u.pathname + u.search;
}
function arrow(key: SortKey): string {
  return /-asc$|^latency$|^name$|^status$|^host$|^protocol$/.test(key) ? '▲' : '▼';
}
const bucketTitle: Record<Bucket, string> = { ok: 'Alive servers', access: 'Servers that need auth', setup: 'Servers that need setup', down: 'Down or broken servers', all: 'Every server' };
const heading = host ? host : q ? `Servers matching “${q}”` : status === 'gated' ? 'Servers that need auth or setup' : ['ok', '', 'access', 'setup', 'down'].includes(status) ? bucketTitle[activeBucket] : `${label(status)} servers`;
// The default view is the page search engines index, so its title and description say what the list is.
const title = host ? `Servers on ${host}` : defaultView ? 'MCP server list, ranked by token cost' : heading;
const description = defaultView
  ? 'Every remote and package MCP server in the official registry: alive or down, tool count and the context tokens its tool list costs, ranked. Filter by host, protocol, transport and token range.'
  : undefined;
// Every sort, filter and page is its own database read, so crawlers index only the first page of the default view.
const robots = filtered || page > 1 || sort !== DEFAULT_SORT ? 'noindex, follow' : undefined;
/** Everything but the sort, as hidden fields for the small sort form on narrow screens. */
const hiddenForSort = [...p.entries()].filter(([k]) => !['sort', 'page', 'c', 'd', 'p'].includes(k));
const countLine = total !== null ? `${num(total)} servers` : rows.length ? `${num(rows.length)}${hasNext ? '+' : ''} servers on this page` : 'no servers';
---

<Layout title={title} description={description} robots={robots}>
  <p class="kicker">{run ? `probed ${run.probedAt.slice(0, 10)}` : ''}</p>
  <h1 class="poster">{heading}</h1>

  <form class="checkform search" method="get" action="/servers" role="search">
    <input type="search" name="q" value={q} placeholder="Search by name, title, description or host" autocomplete="off" aria-label="Search servers" />
    {statusParam && <input type="hidden" name="status" value={statusParam} />}
    {host && <input type="hidden" name="host" value={host} />}
    {protocol && <input type="hidden" name="protocol" value={protocol} />}
    {transport && <input type="hidden" name="transport" value={transport} />}
    {tokensParam && <input type="hidden" name="tokens" value={tokensParam} />}
    {sort !== DEFAULT_SORT && <input type="hidden" name="sort" value={sort} />}
    <button type="submit">Search</button>
  </form>

  <nav class="segments" aria-label="Result">
    {BUCKETS.map((b) => (
      <a class={`seg ${b}${activeBucket === b ? ' active' : ''}`} href={bucketHref(b)} rel="nofollow" aria-current={activeBucket === b ? 'true' : undefined}>
        <span class="seg-label">{b === 'ok' ? 'Alive' : b === 'access' ? 'Needs auth' : b === 'setup' ? 'Needs setup' : b === 'down' ? 'Down' : 'All'}</span>
        {counts && <span class="seg-count">{num(counts[b])}</span>}
      </a>
    ))}
  </nav>

  {causes.length > 0 && (
    <nav class="chips causes" aria-label={activeBucket === 'down' ? 'Why the server is down' : 'What the server needs'}>
      <span class="chips-label">{activeBucket === 'down' ? 'cause' : 'needs'}</span>
      <a class={`chip${status === activeBucket ? ' active' : ''}`} href={bucketHref(activeBucket)} rel="nofollow">any</a>
      {causes.map((c) => (
        <a class={`chip${status === c.key ? ' active' : ''}`} href={withParams({ status: c.key })} rel="nofollow">{c.label} <b>{num(c.count)}</b></a>
      ))}
    </nav>
  )}

  <details class="more" open={Boolean(host || protocol || transport || tokensParam) || undefined}>
    <summary>More filters{(host || protocol || transport || tokensParam) && <span class="muted"> · {[host, rangeLabel, protocol && `protocol ${protocol}`, transport && transportLabel[transport]].filter(Boolean).join(' · ')}</span>}</summary>
    <form class="more-form" method="get" action="/servers">
      {q && <input type="hidden" name="q" value={q} />}
      {(statusParam || defaultView) && <input type="hidden" name="status" value={statusParam || 'ok'} />}
      {sort !== DEFAULT_SORT && <input type="hidden" name="sort" value={sort} />}
      <label>Host
        <input type="text" name="host" value={host} list="host-options" placeholder="any" autocomplete="off" spellcheck="false" />
        <datalist id="host-options">
          {hostOptions.map((h) => <option value={h} />)}
        </datalist>
      </label>
      <div class="range" role="group" aria-label="Tokens the tool list costs">
        <span class="range-label">Tokens</span>
        <span class="range-inputs">
          <input type="number" name="tmin" value={range && range.lo > 0 ? range.lo : ''} min="0" step="1" inputmode="numeric" placeholder="0" aria-label="Tokens from" />
          <span class="range-to">to</span>
          <input type="number" name="tmax" value={range?.hi ?? ''} min="0" step="1" inputmode="numeric" placeholder="any" aria-label="Tokens up to" />
        </span>
      </div>
      <label>Protocol
        <select name="protocol">
          <option value="">any</option>
          {protocols.map((v) => <option value={v} selected={protocol === v}>{v}</option>)}
        </select>
      </label>
      <label>Transport
        <select name="transport">
          <option value="">any</option>
          <option value="streamable-http" selected={transport === 'streamable-http'}>streamable http</option>
          <option value="sse" selected={transport === 'sse'}>sse</option>
          <option value="stdio" selected={transport === 'stdio'}>stdio (npm, PyPI)</option>
        </select>
      </label>
      <button type="submit">Apply</button>
    </form>
  </details>

  {active.length > 0 && (
    <div class="chips active-filters" aria-label="Active filters">
      <span class="chips-label">showing</span>
      {active.map((a) => (
        <a class="chip on" href={a.href} rel="nofollow" title="Remove this filter">{a.label} <span class="x" aria-hidden="true">×</span></a>
      ))}
      <a class="chip clear" href="/servers" rel="nofollow">clear all</a>
    </div>
  )}

  <div class="count-line">
    <p class="small muted">
      {countLine}{host && <> on {host}</>}{pages !== null && <> · page {page} of {num(pages)}</>}
      {(hasPrev || hasNext) && (
        <span class="brief-pager">
          <a class={`pbtn${hasPrev && prevHref ? '' : ' disabled'}`} href={hasPrev && prevHref ? prevHref : undefined} rel="nofollow" aria-label="Previous page" aria-disabled={hasPrev && prevHref ? undefined : 'true'}>‹</a>
          <a class={`pbtn${hasNext && nextHref ? '' : ' disabled'}`} href={hasNext && nextHref ? nextHref : undefined} rel="nofollow" aria-label="Next page" aria-disabled={hasNext && nextHref ? undefined : 'true'}>›</a>
        </span>
      )}
    </p>
    <form class="sort-mobile" method="get" action="/servers">
      {hiddenForSort.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <label>Sort
        <select name="sort">
          {(Object.keys(SORTS) as SortKey[]).map((k) => <option value={k} selected={sort === k}>{SORTS[k].label}</option>)}
        </select>
      </label>
      <button type="submit">Go</button>
    </form>
  </div>

  <div class="frame">
    <table>
      <thead>
        <tr>
          {columns.map((c) => {
            const isActive = sort === c.first || sort === c.second;
            const next = sort === c.first ? c.second : c.first;
            return (
              <th class={c.num ? 'num' : ''} aria-sort={isActive ? (arrow(sort) === '▲' ? 'ascending' : 'descending') : undefined}>
                <a class={`sort${isActive ? ' active' : ''}`} href={sortHref(next)} rel="nofollow" title={`Sort by ${SORTS[next].label}`}>{c.label}{isActive && <span class="arrow">{arrow(sort)}</span>}</a>
              </th>
            );
          })}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="break">
              <a href={`/s/${r.name}`}>{r.name}</a>
              {r.title && r.title !== r.name && <span class="sub">{r.title}</span>}
            </td>
            <td>
              <span class={`tag ${bucket(r.status)}`}>{label(r.status)}</span>
              {r.status === 'auth' && r.auth_scheme && <span class="sub">{r.auth_scheme}</span>}
              {(r.toolset_siblings ?? 0) > 0 && <span class="sub">same tools as {num(r.toolset_siblings)} other{r.toolset_siblings === 1 ? '' : 's'}</span>}
            </td>
            <td class="num">{num(r.tool_count)}</td>
            <td class="num" title={r.claude_tokens != null ? `exact for Claude${r.claude_tokens_cc != null ? `, ${num(r.claude_tokens_cc)} in Claude Code` : ''}` : r.tools_tokens != null ? 'o200k_base estimate, no exact count yet' : undefined}>{r.claude_tokens != null ? tokens(r.claude_tokens) : r.tools_tokens != null ? <span class="faint">~{tokens(r.tools_tokens)}</span> : r.derived_status === 'ok' && (r.derived_claude_tokens ?? r.derived_tools_tokens) != null ? <span class="faint" title={`from the publisher's package ${r.derived_package}`}>pkg {tokens(r.derived_claude_tokens ?? r.derived_tools_tokens)}</span> : ''}</td>
            <td class="num">{ms(r.init_ms)}</td>
            <td class="mono faint">{r.protocol_version ?? ''}</td>
            <td class="mono break"><a class="plain muted" href={`/servers?host=${encodeURIComponent(r.host)}`}>{r.host}</a></td>
          </tr>
        ))}
        {rows.length === 0 && <tr><td colspan="7" class="muted">Nothing matches.</td></tr>}
      </tbody>
    </table>
  </div>

  <Pager page={page} pages={pages} hasNext={hasNext} hasPrev={hasPrev} nextHref={nextHref} prevHref={prevHref} maxNumbered={MAX_NUMBERED_PAGE} url={Astro.url} position="bottom" />
</Layout>

<style>
  .search { margin-top: 1.25rem; }
  .search input { padding: 0.8rem 1rem; font-size: 0.95rem; }

  /* The result as a segmented control: one row, counts under the labels. */
  .segments { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; margin-top: 12px; border: 1px solid var(--line); background: var(--line); }
  .seg { display: flex; flex-direction: column; gap: 4px; padding: 0.7rem 0.9rem; background: var(--surface); color: var(--ink-muted); text-decoration: none; min-width: 0; }
  .seg-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .seg-count { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--ink); }
  .seg:hover { background: var(--panel); }
  .seg.active { box-shadow: inset 0 -3px 0 var(--ink-faint); }
  .seg.ok.active { box-shadow: inset 0 -3px 0 var(--up); background: var(--up-soft); }
  .seg.ok.active .seg-count { color: var(--up); }
  .seg.access.active, .seg.setup.active { box-shadow: inset 0 -3px 0 var(--gated); background: var(--gated-soft); }
  .seg.access.active .seg-count, .seg.setup.active .seg-count { color: var(--gated); }
  .seg.down.active { box-shadow: inset 0 -3px 0 var(--accent); background: var(--accent-soft); }
  .seg.down.active .seg-count { color: var(--accent-strong); }
  .seg.all.active { background: var(--panel); }

  /* Chips: the causes of the active bucket, and the filters that are on. */
  .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; }
  .chips-label { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-faint); margin-right: 4px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 0.3rem 0.65rem; border: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--ink-muted); text-decoration: none; white-space: nowrap; }
  .chip b { font-weight: 500; color: var(--ink-faint); }
  .chip:hover { background: var(--panel); color: var(--ink); }
  .chip.active { background: var(--ink); border-color: var(--ink); color: var(--surface); }
  .chip.active b { color: var(--surface); opacity: 0.7; }
  .chip.on { background: var(--panel); color: var(--ink); }
  .chip .x { color: var(--ink-faint); font-size: 0.9rem; line-height: 1; }
  .chip.on:hover .x { color: var(--accent); }
  .chip.clear { border-style: dashed; color: var(--accent); }

  /* Host, protocol and transport, folded away until needed. */
  .more { margin-top: 10px; }
  .more summary { cursor: pointer; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); list-style: none; display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; white-space: nowrap; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; display: inline-block; width: 1em; color: var(--accent); }
  .more[open] summary::before { content: '−'; }
  .more summary .muted { text-transform: none; letter-spacing: 0.04em; }
  .more-form { display: grid; grid-template-columns: minmax(170px, 1.3fr) minmax(190px, 1.2fr) minmax(140px, 1fr) minmax(140px, 1fr) auto; gap: 1px; margin-top: 8px; border: 1px solid var(--line); background: var(--line); max-width: 960px; }
  .more-form label, .more-form .range { display: flex; flex-direction: column; gap: 6px; padding: 0.625rem 0.75rem 0.75rem; background: var(--surface); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-faint); }
  .more-form select, .more-form input { width: 100%; min-width: 0; }
  .range-inputs { display: flex; align-items: center; gap: 6px; }
  .range-inputs input { flex: 1 1 0; -moz-appearance: textfield; }
  .range-inputs input::-webkit-outer-spin-button, .range-inputs input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .range-to { text-transform: none; letter-spacing: 0.04em; color: var(--ink-faint); }
  .more-form button { border: 0; padding: 0 1.1rem; background: var(--surface); color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; }
  .more-form button:hover { background: var(--ink); color: var(--surface); }

  /* The line above the table: count, page, two arrows; the sort select on narrow screens only. */
  .count-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0 6px; flex-wrap: wrap; }
  .count-line p { margin: 0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .brief-pager { display: inline-flex; gap: 4px; }
