---
import Layout from '../layouts/Layout.astro';
import { latestRun, headline } from '../lib/db';
import { num, pct, tokens, date, modelName } from '../lib/format';

const run = await latestRun();
const cost = run ? headline(run) : null;
const inModel = cost?.exact ? ` in ${modelName(cost.model)}` : '';
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=3600');
const up = run?.ok ?? 0;
const gated = run ? (run.byStatus.auth ?? 0) + (run.byStatus.payment ?? 0) + (run.byStatus.newer_protocol ?? 0) : 0;
const down = run ? run.probed - up - gated : 0;

// The product and the website, named "mcpcost", so search engines read the one-word query as a brand query.
const description =
  'Is this MCP server alive? What does it cost your context window? Daily health and token cost of every remote and package server in the official MCP registry.';
const siteUrl = new URL('/', Astro.site ?? Astro.url).toString();
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'mcpcost',
      alternateName: 'mcpcost.ulehla.dev',
      url: siteUrl,
      description
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}#software`,
      name: 'mcpcost',
      url: siteUrl,
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      sameAs: ['https://github.com/ondraulehla/mcpcost', 'https://www.npmjs.com/package/mcpcost']
    }
  ]
};
---

<Layout title="mcpcost" description={description} jsonld={jsonld}>
  <p class="kicker">every server in the MCP registry, probed each day</p>
  <h1 class="poster hero hero-rise">mcpcost measures what MCP servers cost <span class="accent">before the first prompt</span></h1>

  <div class="actions-grid">
    <section class="panel" aria-labelledby="check-h">
      <h2 id="check-h" class="panel-title">Check a server</h2>
      <form class="checkform" method="get" action="/check">
        <input type="text" name="target" placeholder="URL or registry name" required autocomplete="off" aria-label="Server URL or registry name" />
        <button type="submit">Check</button>
      </form>
      <p class="muted small">A registry name opens its page. Any other URL is probed now, with the same steps as the daily run.</p>
    </section>
    <section class="panel" aria-labelledby="own-h">
      <h2 id="own-h" class="panel-title">Measure your own config</h2>
      <div class="copy-row">
        <pre>npx mcpcost</pre>
        <button type="button" class="copy" data-copy="npx mcpcost" aria-label="Copy the command">Copy</button>
      </div>
      <p class="muted small">Reads the configs of Claude Code, Claude Desktop, Cursor, VS Code, Windsurf and Gemini CLI, starts each server and prints the cost per server. <code>--budget</code> makes it a CI check. <a href="https://www.npmjs.com/package/mcpcost" rel="noopener">npm</a> · <a href="https://github.com/ondraulehla/mcpcost#in-ci-as-a-github-action" rel="noopener">GitHub Action</a></p>
    </section>
  </div>

  <nav class="links" aria-label="Sections">
    <a href="/servers">Servers<span>search, filter, sort</span></a>
    <a href="/tokens">Tokens<span>what a server costs</span></a>
    <a href="/statistics">Statistics<span>results, costs, protocols, publishers</span></a>
    <a href="/changes">Changes<span>new, gone, down, back, heavier</span></a>
    <a href="/methodology">Method<span>how we measure</span></a>
    <a href="/report">Report<span>the state of the registry, by month</span></a>
  </nav>

  {run && (
    <section class="panel today" aria-labelledby="today-h">
      <h2 id="today-h" class="panel-title">The registry today</h2>
      <div class="stats">
        <div class="stat"><b>{pct(up, run.probed)}</b><span>alive</span></div>
        <div class="stat"><b>{pct(gated, run.probed)}</b><span>need auth, payment, env or args</span></div>
        <div class="stat"><b>{pct(down, run.probed)}</b><span>down or broken</span></div>
        <div class="stat"><b>{tokens(cost!.stats.median)}</b><span>median tokens per server{inModel}</span></div>
        <div class="stat"><b>{tokens(cost!.stats.p90)}</b><span>90th percentile</span></div>
        <div class="stat"><b>{tokens(cost!.stats.max)}</b><span>heaviest server</span></div>
      </div>
      <p class="muted small">{num(run.probed)} servers · probed {date(run.probedAt)} · <a href="/statistics">statistics</a> · <a href="/changes">what changed</a></p>
    </section>
  )}

  <p class="why">Every server you connect hands its tool definitions to the model at the start of a session, and you pay those tokens in every turn. mcpcost tells you if a server is alive and how many tokens its tools take, as Claude counts them. <a href="/methodology">How we measure</a>. The monthly report, <a href="/report/2026-10">The state of the MCP registry, October 2026</a>, has the numbers and a CC BY 4.0 dataset.</p>
</Layout>

<style>
  .actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .actions-grid .panel { margin: 0; }
  .panel p { margin: 0.75rem 0 0; }
  .links { margin-top: 1.5rem; }
  .today { margin-top: 1.5rem; }
  .today .stats { margin-top: 0; }
  .why { margin: 2.5rem 0 0; padding: 1rem 1.25rem; border: 1px solid var(--line); font-size: 0.95rem; line-height: 1.625; color: var(--ink-muted); }
  /* the command with a copy cell, like the e-mail cell of ulehla.dev */
  /* The same box as the check form next to it: one height, one background, one inset. */
  .copy-row { display: flex; align-items: stretch; border: 1px solid var(--line); background: var(--surface); }
  .copy-row pre { flex: 1; min-width: 0; margin: 0; border: 0; background: transparent; padding: 0.75rem 0.875rem; font-family: var(--font-mono); font-size: 0.95rem; line-height: normal; color: var(--ink); }
  .copy-row .copy { border: 0; border-left: 1px solid var(--line); padding: 0 1.25rem; background-color: transparent; color: var(--accent); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; cursor: pointer; background-image: linear-gradient(var(--ink), var(--ink)); background-position: bottom; background-repeat: no-repeat; background-size: 100% 0%; transition: background-size 0.28s var(--ease-out-quint), color 0.18s 60ms; }
  .copy-row .copy:hover, .copy-row .copy:focus-visible { color: var(--surface); background-size: 100% 100%; }
  @media (width <= 760px) {
    .actions-grid { grid-template-columns: 1fr; }
  }
</style>