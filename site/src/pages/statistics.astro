---
import Layout from '../layouts/Layout.astro';
import Bars from '../components/charts/Bars.astro';
import Stack from '../components/charts/Stack.astro';
import Trend from '../components/charts/Trend.astro';
import Histogram from '../components/charts/Histogram.astro';
import { latestRun, listHosts, recentRuns } from '../lib/db';
import { bucket, label, num, pct, date, ms, modelName, authKindLabel } from '../lib/format';

const runs = await recentRuns(30);
const run = runs[0] ?? null;
const hosts = run ? await listHosts(12, run) : [];
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=10800');

const gated = run ? (run.byStatus.auth ?? 0) + (run.byStatus.payment ?? 0) + (run.byStatus.newer_protocol ?? 0) : 0;
const down = run ? run.probed - run.ok - gated : 0;
const statusItems = run
  ? Object.entries(run.byStatus).sort((a, b) => b[1] - a[1]).map(([s, n]) => ({ label: label(s), value: n, tone: bucket(s), href: `/servers?status=${s}`, note: pct(n, run.probed) }))
  : [];
const series = [...runs].reverse();
const trend = (pick: (r: (typeof runs)[number]) => number | undefined) =>
  series.flatMap((r) => { const v = pick(r); return v == null ? [] : [{ date: r.probedAt, value: v }]; });
const topHeavy = run ? run.heaviest.slice(0, 12) : [];
const heavyMax = Math.max(1, ...topHeavy.map((h) => h.claudeTokens ?? h.toolsTokens));
---

<Layout title="MCP registry statistics" description="Results, token costs, protocols, auth and publishers of every remote and package server in the MCP registry, as charts with a table under each.">
  <p class="kicker">{run ? `${num(run.probed)} servers · probed ${date(run.probedAt)}` : ''}</p>
  <h1 class="poster">Statistics</h1>

  {!run && <p class="frame pad">No run imported yet.</p>}
  {run && (
    <>
      <section class="panel" aria-labelledby="run-h">
        <h2 id="run-h" class="panel-title">Probed today</h2>
        <div class="stats">
          <div class="stat"><b>{num(run.registryEntries)}</b><span>registry entries, latest versions</span></div>
          <div class="stat"><b>{num(run.probed)}</b><span>probed: {num(run.probed - (run.stdioProbed ?? 0))} remote, {num(run.stdioProbed ?? 0)} npm and PyPI packages</span></div>
          <div class="stat"><b>{num(run.hosts)}</b><span>hosts</span></div>
          <div class="stat"><b>{num(run.uniqueToolsets)}</b><span>distinct tool sets among alive servers</span></div>
          <div class="stat"><b>{num(run.duplicateServers)}</b><span>alive servers that copy another tool set</span></div>
          <div class="stat"><b>{ms(run.initMs.median)}</b><span>median time to initialize</span></div>
        </div>
        <p class="panel-note"><a href="/report/2026-10">The state of the MCP registry, October 2026: the monthly report with a CC BY 4.0 dataset →</a></p>
      </section>

      <section class="panel" aria-labelledby="results-h">
        <h2 id="results-h" class="panel-title">Results</h2>
        <p class="muted small">What every probed server answered. Hover a segment or a bar for the count, or open the table.</p>
        <Stack id="results-stack" segments={[
          { label: 'alive', value: run.ok, tone: 'up', href: '/servers?status=ok' },
          { label: 'needs auth, payment, env or args', value: gated, tone: 'gated', href: '/servers?status=auth' },
          { label: 'down or broken', value: down, tone: 'down', href: '/servers?status=down' }
        ]} />
        <Bars id="results-bars" items={statusItems} columns={['Result', 'Servers']} />
      </section>

      {run.claudeTokens && (
        <section class="panel" aria-labelledby="cost-h">
          <h2 id="cost-h" class="panel-title">Token cost in {modelName(run.claudeTokens.model)}, alive servers</h2>
          <p class="muted small">Exact counts from the Anthropic count_tokens endpoint. {num(run.claudeTokens.counted)} servers counted, {num(run.claudeTokens.refused)} have a schema the API refuses.</p>
          <div class="stats">
            <div class="stat"><b>{num(run.claudeTokens.median)}</b><span>median</span></div>
            <div class="stat"><b>{num(run.claudeTokens.p90)}</b><span>90th percentile</span></div>
            <div class="stat"><b>{num(run.claudeTokens.p99)}</b><span>99th percentile</span></div>
            <div class="stat"><b>{num(run.claudeTokens.max)}</b><span>maximum</span></div>
            <div class="stat"><b>{num(run.claudeTokens.claudeCode.median)}</b><span>median in Claude Code</span></div>
            <div class="stat"><b>{run.claudeTokens.ratioToEstimate.median.toFixed(2)}×</b><span>exact over the o200k estimate</span></div>
          </div>
          {run.claudeTokens.histogram && (
            <>
              <h3>Servers per cost band</h3>
              <Histogram id="cost-histogram" edges={run.claudeTokens.histogram.edges} bins={run.claudeTokens.histogram.bins} />
            </>
          )}
        </section>
      )}

      <section class="panel" aria-labelledby="heavy-h">
        <h2 id="heavy-h" class="panel-title">Heaviest tool sets</h2>
        <Bars id="heaviest" max={heavyMax} items={topHeavy.map((h) => ({
          label: h.name, sub: `${num(h.toolCount)} tools · ${h.host}`, href: `/s/${h.name}`,
          value: h.claudeTokens ?? h.toolsTokens, note: h.claudeTokens != null ? `${((h.claudeTokens / 200_000) * 100).toFixed(0)} % of Claude's 200k window` : 'estimate'
        }))} columns={['Server', 'Tokens']} />
        <p class="panel-note"><a href="/servers?sort=claude">All servers by token cost →</a></p>
      </section>

      {series.length > 1 && (
        <section class="panel" aria-labelledby="runs-h">
          <h2 id="runs-h" class="panel-title">Run by run</h2>
          <p class="muted small">The last {series.length} daily runs. Hover a point for its value.</p>
          <h3>Servers that answer and list their tools</h3>
          <Trend id="trend-alive" points={trend((r) => Math.round((r.ok / r.probed) * 1000) / 10)} unit=" %" format={(n) => n.toFixed(1)} />
          <h3>Median tokens of a tool set{run.claudeTokens ? ` in ${modelName(run.claudeTokens.model)}` : ''}</h3>
          <Trend id="trend-median" points={trend((r) => (run.claudeTokens ? r.claudeTokens?.median : r.toolsTokens.median))} />
          <h3>Remote servers in the registry</h3>
          <Trend id="trend-probed" points={trend((r) => r.probed)} />
        </section>
      )}

      <section class="panel" aria-labelledby="protocols-h">
        <h2 id="protocols-h" class="panel-title">Protocol versions, alive servers</h2>
        <Bars id="protocols" items={Object.entries(run.protocols).filter(([v]) => v !== 'unknown').sort((a, b) => b[1] - a[1]).map(([v, n]) => ({ label: v, value: n, href: `/servers?protocol=${v}`, note: pct(n, run.ok) }))} columns={['Negotiated version', 'Servers']} />
      </section>

      <section class="panel" aria-labelledby="auth-h">
        <h2 id="auth-h" class="panel-title">Auth schemes, servers that need auth</h2>
        <Bars id="auth" items={Object.entries(run.authSchemes).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([v, n]) => ({ label: v === 'none' ? 'no WWW-Authenticate header' : v, value: n }))} columns={['WWW-Authenticate', 'Servers']} />
      </section>

      {run.authKinds && (
        <section class="panel" aria-labelledby="access-h">
          <h2 id="access-h" class="panel-title">How a client gets in, servers that need auth</h2>
          <p class="muted small">Read from the public OAuth metadata of each server (RFC 9728 and RFC 8414), never from a token. A server whose authorization server registers clients itself connects from Claude Code, Cursor or <span class="mono">npx mcpcost auth</span> with no setup.</p>
          <Bars id="access" items={Object.entries(run.authKinds).sort((a, b) => b[1] - a[1]).map(([v, n]) => ({ label: authKindLabel(v), value: n, note: pct(n, Object.values(run.authKinds!).reduce((a, b) => a + b, 0)) }))} columns={['Access', 'Servers']} />
        </section>
      )}

      <section class="panel" aria-labelledby="transports-h">
        <h2 id="transports-h" class="panel-title">Transports</h2>
        <Bars id="transports" items={Object.entries(run.transports).sort((a, b) => b[1] - a[1]).map(([v, n]) => ({ label: v, value: n, href: `/servers?transport=${v}`, note: pct(n, run.probed) }))} columns={['Transport', 'Servers']} />
      </section>

      <section class="panel" aria-labelledby="hosts-h">
        <h2 id="hosts-h" class="panel-title">Biggest publishers</h2>
        <p class="muted small">Hosts by the number of registry entries they serve. The tooltip says how many are alive and how many distinct tool sets they have.</p>
        <Bars id="hosts" items={hosts.map((h) => ({ label: h.host, value: h.servers, href: `/servers?host=${encodeURIComponent(h.host)}`, note: `${num(h.ok)} alive, ${num(h.unique_toolsets)} distinct tool sets` }))} columns={['Host', 'Servers']} />
        <p class="panel-note"><a href="/hosts">All hosts →</a></p>
      </section>
    </>
  )}
</Layout>
