{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && npm run mcp:snapshot && vitest run tests/mcp.test.ts && astro build",
    "check": "astro check",
    "test": "vitest run",
    "mcp:snapshot": "vitest run tests/mcp-snapshot.test.ts --update",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:schema:local": "wrangler d1 execute mcp-pulse --local --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute mcp-pulse --remote --file=schema.sql",
    "db:import:local": "wrangler d1 execute mcp-pulse --local --file=../data/latest/import.sql",
    "db:import:remote": "wrangler d1 execute mcp-pulse --remote --file=../data/latest/import.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "astro": "^7.3.5",
    "gpt-tokenizer": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
